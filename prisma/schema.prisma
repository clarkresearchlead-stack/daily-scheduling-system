generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CustomTab {
  id       String @id @default(uuid())
  title    String
  position Int
  tasks    Task[]

  @@index([position])
}

model Task {
  id          String     @id @default(uuid())
  customTabId String?
  customTab   CustomTab? @relation(fields: [customTabId], references: [id], onDelete: SetNull)
  title       String
  note        String     @default("")
  startTime   String     @default("")
  endTime     String     @default("")
  currentTab  String // "fixed", "active", "foraging", "deleted"
  originTab   String // "fixed", "active", "foraging"
  deletedAt   DateTime?
  tabName     String? // Snapshot of tab title for deleted items

  @@index([currentTab])
  @@index([customTabId])
  @@index([currentTab, customTabId])
  @@index([currentTab, startTime, endTime])
  @@index([deletedAt])
}
